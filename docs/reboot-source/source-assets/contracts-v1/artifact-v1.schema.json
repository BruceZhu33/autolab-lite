{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autolab.local/contracts/artifact-v1.schema.json",
  "title": "AutoLab ArtifactV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "job_id",
    "kind",
    "location_kind",
    "remote_path",
    "sha256",
    "size_bytes",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_id": { "$ref": "#/$defs/id" },
    "job_id": { "$ref": "#/$defs/id" },
    "kind": {
      "enum": ["metrics", "checkpoint", "log", "report", "other"]
    },
    "location_kind": {
      "enum": ["remote", "cached", "remote_and_cached"]
    },
    "remote_path": { "$ref": "#/$defs/absolutePath" },
    "local_cache_path": {
      "oneOf": [
        { "$ref": "#/$defs/absolutePath" },
        { "type": "null" }
      ]
    },
    "sha256": { "$ref": "#/$defs/sha256" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "metadata": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    }
  }
}
