{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autolab.local/contracts/manifest-v1.schema.json",
  "title": "AutoLab ManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "job_id",
    "plan_revision_id",
    "project",
    "execution",
    "outputs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "dispatch_id": { "$ref": "#/$defs/id" },
    "job_id": { "$ref": "#/$defs/id" },
    "plan_revision_id": { "$ref": "#/$defs/id" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "workdir", "code_anchor"],
      "properties": {
        "project_id": { "$ref": "#/$defs/id" },
        "workdir": { "$ref": "#/$defs/absolutePath" },
        "code_anchor": { "$ref": "#/$defs/codeAnchor" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "gpu_indices", "timeout_seconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prepend_path": {
              "type": "array",
              "items": { "$ref": "#/$defs/absolutePath" }
            },
            "variables": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "gpu_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "termination_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 15
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "artifacts", "metrics"],
      "properties": {
        "root": { "$ref": "#/$defs/absolutePath" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metricSource" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "codeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        },
        "branch": { "type": "string", "minLength": 1 },
        "dirty_patch_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "non_git_fingerprint": { "$ref": "#/$defs/sha256" }
      },
      "anyOf": [
        { "required": ["git_commit"] },
        { "required": ["non_git_fingerprint"] }
      ]
    },
    "metricSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["json", "csv", "regex"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "selector": { "type": "string" }
      }
    }
  }
}
