{
  "id": "research_multiseed",
  "kind": "research",
  "title": "研究 heavy 档:同变体 3 seed 均值显著提升 → end_round 成功收束",
  "fixture": "fixtures/tiny_repo",
  "tier": "heavy",
  "idea": "验证 base 配置在 kvasir 上的多 seed 稳定性",
  "datasets": ["kvasir"],
  "baseline": {
    "datasets": {
      "kvasir": {"metrics": {"val_dice": 0.8}, "command": "python train.py"}
    }
  },
  "contract": {
    "primary": "val_dice",
    "direction": "maximize",
    "guardrails": [],
    "eval": {}
  },
  "cassette": [
    {
      "content": [
        {
          "type": "tool_use",
          "id": "t1",
          "name": "run_experiment",
          "input": {
            "purpose": "base 变体 3 seed 均值验证",
            "jobs": [
              {"name": "s1", "dataset": "kvasir", "variant": "base", "seed": 1,
               "command": "python train.py --seed 1"},
              {"name": "s2", "dataset": "kvasir", "variant": "base", "seed": 2,
               "command": "python train.py --seed 2"},
              {"name": "s3", "dataset": "kvasir", "variant": "base", "seed": 3,
               "command": "python train.py --seed 3"}
            ],
            "metrics": [{"name": "val_dice"}]
          }
        }
      ]
    },
    {
      "content": [
        {"type": "tool_use", "id": "t2", "name": "wait_jobs", "input": {"job_ids": "{{jobs}}"}}
      ]
    },
    {
      "content": [
        {
          "type": "tool_use",
          "id": "t3",
          "name": "end_round",
          "input": {
            "hypothesis": "base 配置稳定优于基线",
            "changes": "无代码改动,多 seed 复跑",
            "analysis": "3 seed 均值 0.85,显著高于基线 0.8",
            "next_idea": "",
            "kept": false
          }
        }
      ]
    }
  ],
  "job_metrics": [{"val_dice": 0.84}, {"val_dice": 0.85}, {"val_dice": 0.86}],
  "expect": {
    "status": "done",
    "result.success": true,
    "result.rounds": 1,
    "result.bestGain_gte": 0.04,
    "span_kinds.verify_gte": 1,
    "tool_errors": []
  },
  "budget": {"max_steps": 20}
}
