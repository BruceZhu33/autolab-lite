{
  "id": "research_platform_eval",
  "kind": "research",
  "title": "研究 heavy 档:平台评测链 — 训练自报 0.99 被忽略,判定/证据用评测 0.85",
  "fixture": "fixtures/tiny_repo",
  "tier": "heavy",
  "idea": "验证 base 配置在 kvasir 上的多 seed 稳定性",
  "datasets": ["kvasir"],
  "baseline": {
    "datasets": {
      "kvasir": {"metrics": {"val_dice": 0.8}, "command": "python train.py"}
    }
  },
  "contract": {
    "primary": "val_dice",
    "direction": "maximize",
    "guardrails": [],
    "eval": {"command": "python eval.py"}
  },
  "cassette": [
    {
      "content": [
        {
          "type": "tool_use",
          "id": "t1",
          "name": "run_experiment",
          "input": {
            "purpose": "base 变体 3 seed 均值验证",
            "jobs": [
              {"name": "s1", "dataset": "kvasir", "variant": "base", "seed": 1,
               "command": "python train.py --seed 1"},
              {"name": "s2", "dataset": "kvasir", "variant": "base", "seed": 2,
               "command": "python train.py --seed 2"},
              {"name": "s3", "dataset": "kvasir", "variant": "base", "seed": 3,
               "command": "python train.py --seed 3"}
            ],
            "metrics": [{"name": "val_dice"}]
          }
        }
      ]
    },
    {
      "content": [
        {"type": "tool_use", "id": "t2", "name": "wait_jobs", "input": {"job_ids": "{{jobs}}"}}
      ]
    },
    {
      "content": [
        {
          "type": "tool_use",
          "id": "t3",
          "name": "end_round",
          "input": {
            "hypothesis": "base 配置稳定优于基线",
            "changes": "无代码改动,多 seed 复跑",
            "analysis": "3 seed 评测均值 0.86,显著高于基线 0.8",
            "next_idea": "",
            "kept": false
          }
        }
      ]
    }
  ],
  "job_metrics": [
    {"val_dice": 0.99}, {"val_dice": 0.99}, {"val_dice": 0.99},
    {"val_dice": 0.85}, {"val_dice": 0.86}, {"val_dice": 0.87}
  ],
  "expect": {
    "status": "done",
    "result.success": true,
    "result.lastRound.evaluation.evalMissing": 0,
    "result.lastRound.evaluation.rows.0.value": 0.85,
    "result.lastRound.evaluation.rows.0.evalJobId_contains": "job-",
    "result.lastRound.evidence.evalJobs.0.metrics.val_dice": 0.85,
    "span_kinds.verify_gte": 1
  },
  "budget": {"max_steps": 20}
}
