{
  "name": "autolab-frontend-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo dev --filter=@multica/web",
    "build": "turbo build --filter=@multica/web",
    "typecheck": "turbo typecheck --filter=@multica/web",
    "test": "turbo test --filter=@multica/web",
    "clean": "rm -rf apps/*/{node_modules,.next,.turbo,.source} packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@xmldom/xmldom": "^0.8.13",
      "postcss": "8.5.26",
      "uuid": "11.1.1",
      "shell-quote": "1.9.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@5>brace-expansion": "2.1.4",
      "minimatch@9>brace-expansion": "2.1.4",
      "minimatch@10>brace-expansion": "5.0.9",
      "builder-util-runtime": "9.7.0"
    }
  }
}
