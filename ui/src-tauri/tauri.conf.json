{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "autolab",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "http://localhost:3100",
    "devUrl": "http://localhost:3100"
  },
  "app": {
    "windows": [
      {
        "title": "AutoLab · 自动化科研训练台",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
